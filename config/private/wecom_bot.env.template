# 企业微信智能机器人 凭据模板
#
# 凭据规则 (本项目铁律):
#   1. WECHAT_BOT_ID + WECHAT_BOT_SECRET 必须放环境变量,绝不写入代码/文档/issue
#   2. bot_id 是公开的企业级标识 (类似 AppID, 可入仓)
#   3. bot_secret 是密码级凭据,严禁入任何 chat/issue/commit
#
# 用法 (生产部署):
#   1. 拷贝本文件到 ~/.hermes/wecom_bot.env
#      cp config/private/wecom_bot.env.template ~/.hermes/wecom_bot.env
#   2. 编辑 ~/.hermes/wecom_bot.env 把 REPLACE_ME 替换成真实值
#   3. chmod 600 ~/.hermes/wecom_bot.env
#   4. 在启动脚本里 source: source ~/.hermes/wecom_bot.env && bash start_wecom_ai_bot_*.sh
#
# 验证 (凭据已就位):
#   bash -c '[ -n "$WECHAT_BOT_ID" ] && [ -n "$WECHAT_BOT_SECRET" ] && echo OK'

# 企业级 Bot ID (公开标识, 在企业微信管理后台 → 智能机器人 → 详情可见)
WECHAT_BOT_ID='REPLACE_ME_WITH_BOT_ID'

# 智能机器人 Secret (密码级凭据, 严禁泄露)
# 在企业微信管理后台 → 智能机器人 → 重置 Secret 获取
WECHAT_BOT_SECRET='REPLACE_ME_WITH_BOT_SECRET'
